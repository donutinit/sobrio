{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.4.3",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["guard.js", "match.js", "settings.js", "stats.js", "background.js"]
  },
  "permissions": ["bookmarks", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["proxy.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["boot.js", "settings.js", "style.js", "darkreader.js", "detector.js", "page.js", "toast.js", "speed.js", "shortcuts.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "sobrio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "theme_icons": [
      { "light": "icons/icon-light-16.png", "dark": "icons/icon-16.png", "size": 16 },
      { "light": "icons/icon-light-32.png", "dark": "icons/icon-32.png", "size": 32 }
    ]
  },
  "commands": {
    "open-switcher": {
      "suggested_key": { "default": "Ctrl+Space" },
      "description": "__MSG_commandOpen__"
    }
  },
  "minimum_chrome_version": "127",
  "browser_specific_settings": {
    "gecko": {
      "id": "sobrio@donutinit",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
